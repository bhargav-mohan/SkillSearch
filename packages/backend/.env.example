# Backend environment variables

# Your OpenAI API key (required unless overridden in the UI per-request)
OPENAI_API_KEY=sk-...

# Port for the Express server (default: 3001)
PORT=3001

# Restrict CORS to a specific origin in production (default: allow all)
# CORS_ORIGIN=https://your-frontend-domain.com

# Node environment
NODE_ENV=development
